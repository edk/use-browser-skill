#!/usr/bin/env bash
# pw — wrapper around playwright-cli (headed, one reusable session, persistent
# login, artifacts out of repo). Targets bash 3.2 (macOS default). See SKILL.md.
set -euo pipefail

PW_BIN="${PW_BIN:-playwright-cli}"
PW_SESSION="${PW_SESSION:-pw}"
PW_SCRATCH_DIR="${PW_SCRATCH_DIR:-${TMPDIR:-/tmp}/pw-cli}"
# Persistent on-disk browser profile: log in (and pass 2FA) ONCE and reuse it on
# every later launch and task. PW_EPHEMERAL=1 opts back into throwaway in-memory.
PW_EPHEMERAL="${PW_EPHEMERAL:-0}"
PW_PROFILE_DIR="${PW_PROFILE_DIR:-${HOME}/.cache/pw-cli/profile}"

die() { echo "pw: $*" >&2; exit 2; }

command -v "$PW_BIN" >/dev/null 2>&1 || \
  die "playwright-cli not found on PATH. Install: npm i -g @playwright/cli@latest"

export PLAYWRIGHT_MCP_HEADLESS="${PLAYWRIGHT_MCP_HEADLESS:-false}"
mkdir -p "$PW_SCRATCH_DIR" || die "cannot create scratch dir: $PW_SCRATCH_DIR"
export PLAYWRIGHT_MCP_OUTPUT_DIR="${PLAYWRIGHT_MCP_OUTPUT_DIR:-$PW_SCRATCH_DIR}"

# All playwright-cli calls must use PW_SCRATCH_DIR as their working directory.
# playwright-cli uses cwd to determine which daemon instance to connect to (one
# daemon per workspace, identified by a hash of the cwd). If different pw commands
# run from different cwds they hit different daemons and can't see each other's
# sessions. cd here once so every subsequent playwright-cli call is in the same
# context, regardless of where the user invoked pw from.
cd "$PW_SCRATCH_DIR"

# Absolute path to this script, so self-invocation survives a cd.
case "$0" in
  /*)  SELF="$0" ;;
  */*) SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")" ;;
  *)   SELF="$(command -v "$0")" ;;
esac

# Check that the named session exists AND has status: open.
# Plain grep on the session name is not sufficient — closed sessions remain in
# `playwright-cli list` output under "Browser servers available for attach",
# causing false positives that send `pw open` to `goto` against a dead session.
session_running() {
  "$PW_BIN" list 2>/dev/null | awk \
    -v s="^- ${PW_SESSION}:" \
    '$0 ~ s {found=1; next} found && /status: open/ {exit 0} found && /^-/ {exit 1} END {exit 1}' \
    2>/dev/null
}

# Populate PROFILE_ARGS with the flags that pin a fresh launch to the persistent
# profile (empty when PW_EPHEMERAL=1). Only call this right before launching.
profile_launch_args() {
  PROFILE_ARGS=()
  [[ "$PW_EPHEMERAL" == "1" ]] && return 0
  mkdir -p "$PW_PROFILE_DIR" || die "cannot create profile dir: $PW_PROFILE_DIR"
  # Playwright teardown kills Chrome before it writes its clean-exit marker, so
  # every relaunch of the persistent profile shows the "Restore pages?" crash
  # bubble (and a stray click on Restore resurrects stale tabs). Mark the
  # previous exit clean before launching. Cosmetic-only: page data and logins
  # are flushed by CDP close regardless.
  local prefs="$PW_PROFILE_DIR/Default/Preferences"
  if [[ -f "$prefs" ]]; then
    python3 - "$prefs" <<'PYEOF' || true
import json, sys
path = sys.argv[1]
with open(path) as f:
    prefs = json.load(f)
profile = prefs.setdefault("profile", {})
profile["exit_type"] = "Normal"
profile["exited_cleanly"] = True
with open(path, "w") as f:
    json.dump(prefs, f)
PYEOF
  fi
  PROFILE_ARGS=(--persistent --profile "$PW_PROFILE_DIR")
}

# Remove the cached .session file for PW_SESSION from the playwright daemon dir.
# The daemon caches launch options (including headless:true/false) in this file and
# reuses them on subsequent opens, ignoring the current PLAYWRIGHT_MCP_HEADLESS env.
# Deleting it before launch forces a fresh session that picks up headless=false.
clear_session_cache() {
  find "${HOME}/Library/Caches/ms-playwright/daemon" -maxdepth 2 \
    -name "${PW_SESSION}.session" -delete 2>/dev/null || true
}

# Kill any Chrome processes whose --user-data-dir matches PW_PROFILE_DIR, and clean
# up Chrome's SingletonLock files so the profile can be reused immediately.
# playwright-cli close/kill-all terminates the daemon but can leave Chrome running
# and the profile locked. A locked profile causes "Browser is already in use" on
# the next open. This only targets pw's profile — it never touches a Chrome instance
# using a different profile (e.g. the user's regular browser).
kill_profile_browsers() {
  [[ "$PW_EPHEMERAL" == "1" ]] && return 0
  [[ -d "$PW_PROFILE_DIR" ]] || return 0
  local real_profile
  real_profile="$(cd "$PW_PROFILE_DIR" 2>/dev/null && pwd || echo "$PW_PROFILE_DIR")"
  pgrep -lf "Google Chrome\|Chromium" 2>/dev/null | while IFS=' ' read -r pid _; do
    local cmdline
    cmdline=$(ps -p "$pid" -o command= 2>/dev/null || true)
    if echo "$cmdline" | grep -qF "user-data-dir=${PW_PROFILE_DIR}" || \
       echo "$cmdline" | grep -qF "user-data-dir=${real_profile}"; then
      kill "$pid" 2>/dev/null || true
    fi
  done
  # Remove Chrome profile lock files so the next open doesn't get "already in use".
  rm -f "${PW_PROFILE_DIR}/SingletonLock" \
        "${PW_PROFILE_DIR}/SingletonSocket" \
        "${PW_PROFILE_DIR}/SingletonCookie" 2>/dev/null || true
}

# Strip leading --persistent flag — pw always reuses the named session; this
# flag is a common mistake and would otherwise bypass the open/session_running
# logic by hitting the wildcard case and spawning a new browser context.
while [[ "${1:-}" == "--persistent" ]]; do shift; done

cmd="${1:-help}"
case "$cmd" in
  help|-h|--help)
    profile_mode="persistent ($PW_PROFILE_DIR)"
    [[ "$PW_EPHEMERAL" == "1" ]] && profile_mode="ephemeral (in-memory)"
    cat <<EOF
pw — browser wrapper (headed; one reusable session '${PW_SESSION}'; artifacts in ${PW_SCRATCH_DIR})

Sessions are REUSED: 'pw open URL' navigates the existing browser instead of
launching a new one. The browser uses a ${profile_mode} profile, so you log in
(and pass 2FA) once and it sticks across launches and tasks. Opening a brand-new
browser should be rare — prefer reusing what is already open.

Wrapper verbs:
  pw open URL   open (or reuse) the session and navigate
  pw status     list running sessions
  pw fresh URL  force a NEW browser (close current, relaunch) — rare; only when needed
  pw forget     clear the saved login (close + delete the persistent profile)
  pw end        close the '${PW_SESSION}' session (saved login persists on disk)
  pw nuke       close-all + kill-all + kill profile browsers + wipe scratch dir
  pw selftest   verify headed + no repo litter
  pw help       this help

Env: PW_EPHEMERAL=1 (throwaway in-memory profile), PW_PROFILE_DIR (profile path).
All other commands pass through to playwright-cli, scoped to '${PW_SESSION}'.
playwright-cli's own help follows:
EOF
    "$PW_BIN" --help || true
    ;;
  status)
    exec "$PW_BIN" list
    ;;
  end)
    "$PW_BIN" -s="$PW_SESSION" close 2>/dev/null || true
    kill_profile_browsers
    ;;
  fresh)
    shift
    "$PW_BIN" -s="$PW_SESSION" close >/dev/null 2>&1 || true
    kill_profile_browsers
    profile_launch_args
    clear_session_cache
    exec "$PW_BIN" -s="$PW_SESSION" open ${PROFILE_ARGS[@]+"${PROFILE_ARGS[@]}"} "$@"
    ;;
  forget|logout)
    "$PW_BIN" -s="$PW_SESSION" close >/dev/null 2>&1 || true
    kill_profile_browsers
    rm -rf "$PW_PROFILE_DIR"
    echo "pw: cleared saved login ($PW_PROFILE_DIR). Next 'pw open' starts logged-out."
    ;;
  nuke)
    "$PW_BIN" close-all >/dev/null 2>&1 || true
    "$PW_BIN" kill-all  >/dev/null 2>&1 || true
    kill_profile_browsers
    rm -rf "$PW_SCRATCH_DIR"
    echo "pw: reset (sessions killed, profile browsers killed, scratch wiped: $PW_SCRATCH_DIR; login profile kept: $PW_PROFILE_DIR — 'pw forget' to clear it)"
    ;;
  selftest)
    tmp="$(mktemp -d)"; rc=0
    export PW_PROFILE_DIR="$tmp/profile"
    export PW_SCRATCH_DIR="$tmp/scratch"
    mkdir -p "$tmp/scratch"

    "$SELF" open about:blank >/dev/null

    # pw always cds to PW_SCRATCH_DIR, so playwright-cli list must also run from there
    # to hit the same daemon context.
    if (cd "$PW_SCRATCH_DIR" && "$PW_BIN" list) | awk -v s="$PW_SESSION" '
          $0 ~ "^[[:space:]]*-[[:space:]]*" s ":" {f=1; next}
          /^-[[:space:]]/ {f=0}
          f && /headed: true/ {print "Y"}
        ' | grep -q Y; then :
    else echo "FAIL: session is not headed"; rc=1; fi
    "$SELF" end >/dev/null 2>&1 || true
    rm -rf "$tmp"
    if [[ $rc -eq 0 ]]; then
      mode="persistent"; [[ "$PW_EPHEMERAL" == "1" ]] && mode="ephemeral"
      echo "PASS: headed, single session, $mode login, no repo litter (artifacts -> $PW_SCRATCH_DIR)"
    fi
    exit "$rc"
    ;;
  list|close-all|kill-all|install|--version|-V)
    exec "$PW_BIN" "$@"
    ;;
  -s=*|-s)
    exec "$PW_BIN" "$@"
    ;;
  open)
    shift
    if session_running; then
      if [[ $# -gt 0 ]]; then
        exec "$PW_BIN" -s="$PW_SESSION" goto "$@"
      else
        echo "pw: session '${PW_SESSION}' already open (reusing). 'pw status' to inspect; 'pw fresh URL' to force a new browser."
      fi
    else
      profile_launch_args
      clear_session_cache
      exec "$PW_BIN" -s="$PW_SESSION" open ${PROFILE_ARGS[@]+"${PROFILE_ARGS[@]}"} "$@"
    fi
    ;;
  *)
    exec "$PW_BIN" -s="$PW_SESSION" "$@"
    ;;
esac
